     "quality": "preview",
     "upload_name": null
    },
    "video": "/media/20261014-101419-1db93a/final/lesson.mp4",
    "duration": 113.665,
    "language": "en",
    "voice": "silent",
    "quality": "preview",
    "core_insight": "Speed at an instant makes sense as the value that average speeds over shorter and shorter intervals settle on - geometrically, the slope that secant lines approach as they pivot into the tangent.",
    "objectives": [
     "Interpret an average rate of change as the slope of a secant line.",
     "Explain why the derivative is a limit rather than a division by zero.",
     "Compute the derivative of x squared from the definition."
    ],
    "takeaway": "The derivative turns the meaningless 0/0 into something precise: the slope of the curve - the rate of change - at every single instant.",
    "chapters": [
     {
      "scene": "s1",
      "title": "A question about an instant",
      "start": 0.0,
      "end": 24.199
     },
     {
      "scene": "s2",
      "title": "Slopes of secant lines",
      "start": 24.199,
      "end": 52.332
     },
     {
      "scene": "s3",
      "title": "Let h shrink",
      "start": 52.332,
      "end": 80.465
     },
     {
      "scene": "s4",
      "title": "An example: x squared",
      "start": 80.465,
      "end": 113.665
     }
    ],
    "quiz": [
     {
      "question": "The slope of the secant line through (x, f(x)) and (x+h, f(x+h)) measures...",
      "choices": [
       "the average rate of change of f between x and x+h",
       "the instantaneous rate of change of f at x",
       "the area under the curve from x to x+h",
       "the value of f at x+h"
      ],
      "answer": 0,
      "why": "Rise over run across the interval is exactly an average rate of change."
     },
     {
      "question": "If f(x) = x squared, what is f'(3)?",
      "choices": [
       "3",
       "6",
       "9",
       "2"
      ],
      "answer": 1,
      "why": "The derivative of x squared is 2x, and 2 times 3 is 6."
     },
     {
      "question": "Why can't we just set h = 0 in (f(x+h) - f(x)) / h?",
      "choices": [
       "It gives 0/0, which has no value",
       "It always gives 1",
       "f is not defined at x",
       "It gives a negative number"
      ],
      "answer": 0,
      "why": "Both numerator and denominator become zero; the derivative is the limit as h approaches zero instead."
     }
    ],

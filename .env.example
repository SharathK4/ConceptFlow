# ConceptFlow AI - configuration
# Copy this file to `.env` and fill in the keys you have. Every key is optional
# except GOOGLE_API_KEY for live generation; without it the app runs the
# recorded showcase lessons (LLM_MODE=replay).

# --------------------------------------------------------------- reasoning
# Google AI Studio key (free tier): https://aistudio.google.com/apikey
# Used by both agent frameworks - Google ADK natively and CrewAI through the
# shared model router.
GOOGLE_API_KEY=

# live   - call Gemini
# replay - replay a recorded showcase run (no key needed, no quota used)
# auto   - live when GOOGLE_API_KEY is set, otherwise replay
LLM_MODE=auto

# Model ladders, per role, best first. When a model's free daily quota runs
# out (HTTP 429) the router moves down the ladder and remembers until the
# quota resets at midnight Pacific. Free-tier Flash models allow ~20 requests
# a day each; Flash-Lite ~500. Spreading roles across models multiplies quota.
MODELS_PLANNER=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
MODELS_CODER=gemini-3.8-flash,gemini-3.6-flash,gemini-3-flash-preview,gemini-2.5-flash
MODELS_FIXER=gemini-3.6-flash,gemini-3.8-flash,gemini-3-flash-preview,gemini-2.5-flash
MODELS_VISUAL_CRITIC=gemini-3-flash-preview,gemini-3.6-flash,gemini-3.5-flash-lite
MODELS_PEDAGOGY_CRITIC=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash
MODELS_READER=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash

# ------------------------------------------------------------------- voice
# ElevenLabs (free plan: ~10k credits/month, premade voices only via API)
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Leave blank to pick the first premade voice on your account automatically.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Sarvam AI (free credits on sign-up) - Indian languages: Bulbul TTS and
# Mayura translation. https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_SPEAKER=
# formal | modern-colloquial | classic-colloquial | code-mixed
SARVAM_TRANSLATE_MODE=code-mixed

# Voice used when neither key is set: "edge" (free Microsoft Edge neural
# voices, no key) or "silent" (captions only).
VOICE_FALLBACK=edge

# ----------------------------------------------------------- observability
# Langfuse (free Hobby plan) receives every lesson's trace over OpenTelemetry:
# ADK agents, the A2A hop, the CrewAI crew, MCP tools and every model call.
# https://cloud.langfuse.com -> project -> Settings -> API Keys. Leave blank to
# keep traces only in data/lessons/<id>/trace.jsonl (and the page's Trace view).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com   US: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------------------------------------------------------- agents & tools
# Let LLM agents call the MCP tools themselves in live mode (the CrewAI
# analyst: lookup_concept and check_math; the ADK maths critic: check_math).
LLM_TOOLS=true
# The address the studio is reachable at, advertised in the A2A Agent Card.
# Set it on a deployment, e.g. https://conceptflow-xxxx.a.run.app
PUBLIC_URL=
# Use a writers' room deployed elsewhere instead of the built-in one (A2A URL).
# A2A_WRITERS_ROOM_URL=
# Where lessons, caches and logs are kept (default: ./data).
# DATA_DIR=

# ------------------------------------------------------------------ studio
# preview | draft | hd | hd60 - the resolution of the finished lesson.
DEFAULT_QUALITY=hd
# How many correction rounds the review loop may run.
MAX_REVISIONS=3
# Scenes rendered at once. 0 = decide from CPU count.
RENDER_WORKERS=0
# Seconds allowed per scene render before it is treated as broken.
RENDER_TIMEOUT=240

HOST=127.0.0.1
PORT=8010
